
---
import "../styles/contact.css";
---

<section class="contact-section th-section" id="contact">
  <div class="th-container">

    <div class="contact-label">
      <span class="contact-label-line"></span>
      <span>INICIEMOS ALGO NUEVO</span>
    </div>

    <div class="contact-main">

      <!-- LEFT CONTENT -->
      <div class="contact-content">
        <span class="contact-eyebrow">¿TIENES UNA IDEA?</span>

        <h2>
          Hagamos que<br />
          <span> suceda.</span>
        </h2>

        <p class="contact-description">
          Cada proyecto comienza con una idea. Hablemos de lo que tienes
          en mente, exploremos posibilidades y encontremos la manera de
          convertirlo en algo real.
        </p>

        <a href="mailto:johanmcm@hotmail.com" class="contact-email-link">
          <span>Conversemos sobre tu proyecto</span>
          <span class="contact-link-arrow">↗</span>
        </a>
      </div>

      <!-- RIGHT CONTACT PANEL -->
      <div class="contact-panel">
        <div class="contact-panel-header">
          <span>CONTACTO DIRECTO</span>
          <span class="contact-status">
            <span></span>
            DISPONIBLE PARA PROYECTOS
          </span>
        </div>

        <div class="contact-methods">

          <a href="mailto:TU_CORREO@DOMINIO.COM" class="contact-method">
            <div class="contact-method-icon">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5"/>
                <path d="m3 7 9 6 9-6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>

            <div class="contact-method-info">
              <span>CORREO ELECTRÓNICO</span>
              <h3>johanmcm@hotmail.com</h3>
            </div>

            <span class="contact-method-arrow">↗</span>
          </a>

          <a href="https://www.linkedin.com/in/johan-carrasco-605641274/" target="_blank" rel="noopener noreferrer" class="contact-method">
            <div class="contact-method-icon">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6.5 9.5V17M6.5 6.5v.1M10.5 17v-4.2a2.3 2.3 0 0 1 4.6 0V17M10.5 9.5V17M4 4h16v16H4z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>

            <div class="contact-method-info">
              <span>LINKEDIN</span>
              <h3>Perfil profesional</h3>
            </div>

            <span class="contact-method-arrow">↗</span>
          </a>

          <a href="https://github.com/JohanC25" target="_blank" rel="noopener noreferrer" class="contact-method">
            <div class="contact-method-icon">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M9 19c-4.2 1.3-4.2-2-6-2m12 4v-3.5a3 3 0 0 0-.8-2.3c2.7-.3 5.5-1.3 5.5-6A4.7 4.7 0 0 0 18.5 6a4.3 4.3 0 0 0-.1-3.2S16.8 2.4 14 4a13 13 0 0 0-6 0C5.2 2.4 3.6 2.8 3.6 2.8A4.3 4.3 0 0 0 3.5 6 4.7 4.7 0 0 0 2.3 9.2c0 4.7 2.8 5.7 5.5 6A3 3 0 0 0 7 17.5V21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </div>

            <div class="contact-method-info">
              <span>GITHUB</span>
              <h3>Proyectos & código</h3>
            </div>

            <span class="contact-method-arrow">↗</span>
          </a>

        </div>

        <div class="contact-panel-footer">
          <span>SOFTWARE · IA · 3D · INFRAESTRUCTURA</span>
          <span class="contact-footer-mark">✳</span>
        </div>
      </div>
    </div>

    <!-- BOTTOM STATEMENT -->
    <div class="contact-bottom">
      <div class="contact-bottom-left">
        <span class="contact-bottom-symbol">⌘</span>
        <span>LAS GRANDES IDEAS COMIENZAN CON UNA CONVERSACIÓN.</span>
      </div>

      <a href="#projects" class="contact-back-link">
        Explorar proyectos
        <span>↑</span>
      </a>
    </div>

  </div>
</section>
