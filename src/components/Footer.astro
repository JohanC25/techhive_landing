
---
import "../styles/footer.css";
---

<footer class="techhive-footer">
  <div class="th-container">

    <div class="footer-main">

      <!-- BRAND -->
      <div class="footer-brand-column">
        <a href="#top" class="footer-brand" aria-label="Volver al inicio de TechHive">
          <span class="footer-brand-icon">
            <svg viewBox="0 0 40 40" fill="none" aria-hidden="true">
              <path d="M20 3 34.7 11.5v17L20 37 5.3 28.5v-17L20 3Z" stroke="currentColor" stroke-width="1.6"/>
              <path d="M20 11 27.5 15.3v8.7L20 28.3l-7.5-4.3v-8.7L20 11Z" stroke="currentColor" stroke-width="1.6"/>
              <path d="M20 3v8M34.7 11.5 27.5 15.3M34.7 28.5l-7.2-4.5M20 37v-8.7M5.3 28.5l7.2-4.5M5.3 11.5l7.2 3.8" stroke="currentColor" stroke-width="1.2"/>
            </svg>
          </span>

          <span class="footer-brand-text">TECH<span>HIVE</span></span>
        </a>

        <p class="footer-tagline">
          Una colmena de tecnología.<br />
          <span>Creada para evolucionar.</span>
        </p>
      </div>

      <!-- NAVIGATION -->
      <div class="footer-navigation">
        <div class="footer-column">
          <span class="footer-column-title">EXPLORAR</span>
          <a href="#hive">Ecosistema</a>
          <a href="#projects">Proyectos</a>
          <a href="#services">Servicios</a>
        </div>

        <div class="footer-column">
          <span class="footer-column-title">INFORMACIÓN</span>
          <a href="#about">Sobre mí</a>
          <a href="#experience">Trayectoria</a>
          <a href="#contact">Contacto</a>
        </div>

        <div class="footer-column">
          <span class="footer-column-title">CONECTAR</span>
          <a href="https://www.linkedin.com/" target="_blank" rel="noopener noreferrer">
            LinkedIn ↗
          </a>
          <a href="https://github.com/" target="_blank" rel="noopener noreferrer">
            GitHub ↗
          </a>
          <a href="mailto:TU_CORREO@DOMINIO.COM">
            Correo ↗
          </a>
        </div>
      </div>
    </div>

    <!-- FOOTER BOTTOM -->
    <div class="footer-bottom">
      <span>© {new Date().getFullYear()} TechHive. Todos los derechos reservados.</span>

      <div class="footer-bottom-right">
        <span>DISEÑADO PARA EVOLUCIONAR</span>
        <span class="footer-bottom-symbol">✳</span>
      </div>
    </div>

  </div>
</footer>
