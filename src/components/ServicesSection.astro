
---
import "../styles/services.css";

const services = [
  {
    number: "01",
    title: "Desarrollo de software",
    description:
      "Aplicaciones web, plataformas empresariales y sistemas personalizados diseñados para resolver necesidades reales y optimizar procesos.",
    tags: ["Aplicaciones web", "SaaS", "Sistemas a medida"],
    icon: "code",
  },
  {
    number: "02",
    title: "Inteligencia artificial",
    description:
      "Integración de inteligencia artificial, automatización de procesos, análisis de datos y desarrollo de soluciones inteligentes.",
    tags: ["Machine Learning", "Automatización", "Integración IA"],
    icon: "brain",
  },
  {
    number: "03",
    title: "Diseño y fabricación 3D",
    description:
      "Transformación de ideas en objetos físicos mediante modelado digital, prototipado y fabricación aditiva.",
    tags: ["Modelado 3D", "Prototipado", "Impresión 3D"],
    icon: "cube",
  },
  {
    number: "04",
    title: "Infraestructura tecnológica",
    description:
      "Implementación, configuración y mantenimiento de entornos tecnológicos, redes, servidores y servicios de despliegue.",
    tags: ["Servidores", "Docker", "Redes & DevOps"],
    icon: "network",
  },
];
---

<section class="services-section th-section" id="services">
  <div class="th-container">

    <!-- HEADER -->
    <div class="services-heading">
      <div class="services-label">
        <span class="services-label-line"></span>
        <span>SOLUCIONES TECNOLÓGICAS</span>
      </div>

      <div class="services-heading-content">
        <h2 class="th-section-title">
          Tecnología que<br />
          <span>resuelve y transforma.</span>
        </h2>

        <p class="th-section-description">
          Cada desafío requiere una solución diferente. Conectamos conocimientos,
          herramientas y disciplinas para convertir necesidades en soluciones
          tecnológicas funcionales.
        </p>
      </div>
    </div>

    <!-- SERVICES GRID -->
    <div class="services-grid">
      {services.map((service) => (
        <article class="service-card">
          <div class="service-card-top">
            <span class="service-number">{service.number}</span>

            <div class="service-icon">
              {service.icon === "code" && (
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}

              {service.icon === "brain" && (
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 4.5a3.5 3.5 0 0 0-6.5 2A3.5 3.5 0 0 0 4 13a3.5 3.5 0 0 0 3 5.5A3.5 3.5 0 0 0 12 20V4.5Z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  <path d="M12 4.5a3.5 3.5 0 0 1 6.5 2A3.5 3.5 0 0 1 20 13a3.5 3.5 0 0 1-3 5.5A3.5 3.5 0 0 1 12 20V4.5ZM8 9h4M7 14h5M16 9h-4M17 14h-5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              )}

              {service.icon === "cube" && (
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m12 3 8 4.5v9L12 21l-8-4.5v-9L12 3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  <path d="m4 7.5 8 4.5 8-4.5M12 12v9M8 5.25l8 4.5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                </svg>
              )}

              {service.icon === "network" && (
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <rect x="9" y="3" width="6" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
                  <rect x="3" y="16" width="6" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
                  <rect x="15" y="16" width="6" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/>
                  <path d="M12 8v4m-6 0h12m-12 0v4m12-4v4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                </svg>
              )}
            </div>
          </div>

          <div class="service-card-content">
            <h3>{service.title}</h3>
            <p>{service.description}</p>

            <div class="service-tags">
              {service.tags.map((tag) => (
                <span>{tag}</span>
              ))}
            </div>
          </div>

          <div class="service-card-footer">
            <span>ÁREA DE SOLUCIÓN</span>
            <span class="service-card-arrow">↗</span>
          </div>
        </article>
      ))}
    </div>

    <!-- BOTTOM CTA -->
    <div class="services-bottom">
      <div class="services-bottom-copy">
        <span>¿TIENES UN PROYECTO EN MENTE?</span>
        <p>Conversemos sobre cómo podemos hacerlo realidad.</p>
      </div>

      <a href="#contact" class="services-contact-link">
        Hablemos
        <span>↗</span>
      </a>
    </div>

  </div>
</section>
