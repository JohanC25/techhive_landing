---

<section class="experience-section th-section" id="experience">
  <div class="th-container">

    <!-- HEADER -->
    <div class="experience-heading">
      <div class="experience-label">
        <span class="experience-label-line"></span>
        <span>TRAYECTORIA & CONOCIMIENTO</span>
      </div>

      <div class="experience-heading-content">
        <h2 class="th-section-title">
          Experiencia.<br />
          <span>Aprendizaje continuo.</span>
        </h2>

        <p class="th-section-description">
          Un recorrido entre el soporte tecnológico, el desarrollo de software
          y la inteligencia artificial. Cada experiencia suma nuevas perspectivas
          para construir mejores soluciones.
        </p>
      </div>
    </div>

    <!-- CONTENT GRID -->
    <div class="experience-grid">

      <!-- TIMELINE -->
      <div class="experience-column">
        <div class="experience-column-header">
          <span>01 / EXPERIENCIA</span>
          <span class="experience-header-line"></span>
        </div>

        <div class="experience-timeline">
          {experience.map((item) => (
            <article class="experience-item">
              <div class="experience-timeline-marker">
                <span></span>
              </div>

              <div class="experience-item-content">
                <span class="experience-period">{item.period}</span>
                <span class="experience-type">{item.type}</span>

                <h3>{item.role}</h3>
                <h4>{item.organization}</h4>

                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>

        <!-- EDUCATION -->
        <div class="education-block">
          <div class="experience-column-header">
            <span>02 / FORMACIÓN</span>
            <span class="experience-header-line"></span>
          </div>

          <div class="education-list">
            {education.map((item) => (
              <article class="education-item">
                <div class="education-item-icon">
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="m2.5 9 9.5-5 9.5 5-9.5 5-9.5-5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                    <path d="M6.5 11.1v5.1c3.3 2.5 7.7 2.5 11 0v-5.1M21.5 9v6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>
                </div>

                <div class="education-item-content">
                  <h3>{item.degree}</h3>
                  <span>{item.institution}</span>
                  <p>{item.detail}</p>
                </div>
              </article>
            ))}
          </div>
        </div>
      </div>

      <!-- TECHNOLOGY STACK -->
      <div class="technology-column">
        <div class="experience-column-header">
          <span>03 / TECNOLOGÍAS & HERRAMIENTAS</span>
          <span class="experience-header-line"></span>
        </div>

        <div class="technology-panel">
          <div class="technology-panel-intro">
            <span class="technology-panel-icon">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="m8 8-4 4 4 4M16 8l4 4-4 4M14 5l-4 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>

            <div>
              <h3>Stack tecnológico</h3>
              <p>Herramientas y tecnologías utilizadas en distintos proyectos.</p>
            </div>
          </div>

          <div class="technology-groups">
            <div class="technology-group">
              <span class="technology-group-title">DESARROLLO</span>
              <div class="technology-tags">
                {technologies.filter((t) => ["Python", "PHP", "JavaScript", "TypeScript", "Vue", "Laravel", "Django"].includes(t.name)).map((tech) => (
                  <span class={`technology-tag ${tech.class}`}>{tech.name}</span>
                ))}
              </div>
            </div>

            <div class="technology-group">
              <span class="technology-group-title">BASES DE DATOS & MENSAJERÍA</span>
              <div class="technology-tags">
                {technologies.filter((t) => ["PostgreSQL", "RabbitMQ"].includes(t.name)).map((tech) => (
                  <span class={`technology-tag ${tech.class}`}>{tech.name}</span>
                ))}
              </div>
            </div>

            <div class="technology-group">
              <span class="technology-group-title">INFRAESTRUCTURA & DEVOPS</span>
              <div class="technology-tags">
                {technologies.filter((t) => ["Docker", "Kubernetes", "Jenkins", "VMware", "VirtualBox"].includes(t.name)).map((tech) => (
                  <span class={`technology-tag ${tech.class}`}>{tech.name}</span>
                ))}
              </div>
            </div>

            <div class="technology-group">
              <span class="technology-group-title">CALIDAD & TESTING</span>
              <div class="technology-tags">
                {technologies.filter((t) => ["Selenium", "Postman", "SonarQube"].includes(t.name)).map((tech) => (
                  <span class={`technology-tag ${tech.class}`}>{tech.name}</span>
                ))}
              </div>
            </div>

            <div class="technology-group">
              <span class="technology-group-title">PRODUCTIVIDAD</span>
              <div class="technology-tags">
                {technologies.filter((t) => ["Microsoft 365"].includes(t.name)).map((tech) => (
                  <span class={`technology-tag ${tech.class}`}>{tech.name}</span>
                ))}
              </div>
            </div>
          </div>

          <div class="technology-panel-footer">
            <span>CONOCIMIENTO EN CONSTANTE EVOLUCIÓN</span>
            <span class="technology-footer-mark">✳</span>
          </div>
        </div>
      </div>

    </div>

    <!-- BOTTOM -->
    <div class="experience-bottom">
      <span class="experience-bottom-mark">✳</span>
      <p>
        <strong>Aprender, construir y mejorar.</strong>
        La tecnología nunca se detiene, y tampoco la curiosidad por explorarla.
      </p>
    </div>

  </div>
</section>
