const experience = [
  {
    period: "FEB 2025 — MAR 2026",
    role: "Desarrollador Full Stack IA",
    organization: "Magic World Computers → TechHive · Desarrollo de producto SaaS",
    description:
      "Diseñé y desarrollé TechHive desde cero, inicialmente como una plataforma empresarial para Magic World Computers y posteriormente evolucionada hacia un producto SaaS independiente del cual obtuve los derechos de comercialización. Responsable de toda la arquitectura, desarrollo Full Stack, integración de IA, infraestructura y despliegue. Implementé módulos de servicio técnico e inventario para clientes y personal, chatbot contextual conectado a OpenAI API y un sistema funcional de predicción de ventas.",
    type: "DESARROLLO DE PRODUCTO · SaaS & IA",
  },
  {
    period: "FEB 2024 — FEB 2025",
    role: "Desarrollador Full Stack",
    organization: "Magic World Computers — Quito, Ecuador",
    description:
      "Diseñé y desarrollé ServiceTrack desde cero, incluyendo arquitectura, desarrollo Full Stack y despliegue. Implementé una plataforma gamificada de soporte técnico con recepción de equipos mediante API, gestión de actividades, reportes, historiales, guías de reparación y videotutoriales. Integré ChatGPT API para asistencia técnica y desarrollé un sistema de recomendaciones basado en Machine Learning que identificaba métricas de bajo rendimiento y generaba recomendaciones personalizadas. Implementé un sistema de recompensas donde los técnicos acumulaban y canjeaban puntos por actividades completadas.",
    type: "DESARROLLO FULL STACK · IA & ML",
  },
  {
    period: "JUN 2023 — ABR 2024",
    role: "Full Stack Developer",
    organization: "Join Solutions — Quito, Ecuador",
    description:
      "Tras completar mi periodo de pasantía, fui contratado a tiempo completo para continuar desarrollando sistemas empresariales. Trabajé en módulos existentes de facturación electrónica, inventarios y otros procesos de negocio, desarrollando funcionalidades de frontend, backend, bases de datos y APIs. Implementé automatización de reportes de ventas, compras e inventarios, consultas SQL y procedimientos almacenados para estadísticas dinámicas. Participé en el desarrollo colaborativo mediante Git, ramas individuales y metodología Scrum.",
    type: "DESARROLLO FULL STACK",
  },
  {
    period: "MAR 2023 — MAY 2023",
    role: "Pasante Full Stack Developer",
    organization: "Join Solutions — Quito, Ecuador",
    description:
      "Participé en el desarrollo y mantenimiento de sistemas empresariales utilizando Laravel, Vue 3 y TypeScript. Colaboré en la implementación de funcionalidades para módulos existentes, trabajando tanto en frontend como backend, bases de datos, APIs, autenticación y paneles administrativos. Esta etapa permitió consolidar mis conocimientos prácticos de desarrollo Full Stack y trabajo colaborativo en proyectos reales.",
    type: "PASANTÍA · DESARROLLO DE SOFTWARE",
  },
  {
    period: "MAR 2021 — FEB 2023",
    role: "Técnico de servicio y soporte",
    organization: "Magic World Computers — Quito, Ecuador",
    description:
      "Diagnóstico y reparación de computadoras, laptops e impresoras, mantenimiento preventivo y correctivo, instalación de sistemas operativos, programas y controladores, configuración de redes LAN y equipos tecnológicos. Gestión de recepción de equipos, seguimiento de reparaciones, inventario y venta de productos. Atención directa al cliente, asesoramiento técnico y resolución de incidencias.",
    type: "SOPORTE TÉCNICO · HARDWARE & REDES",
  },
];

